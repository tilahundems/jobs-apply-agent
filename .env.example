# SQLite file, relative to the repository root. No database server required.
DATABASE_FILE=data/job-apply-agent.db
# SQLite has no row-level security, so this build runs single-tenant.
MULTI_TENANCY=false
VITE_MULTI_TENANCY=false
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
# NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Leave empty when the web server proxies /api. Set this when the API uses a separate origin.
VITE_API_URL=
ALLOW_DEMO_SEED=true
SEED_USER_NAME=Demo User
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo-password
SEED_MEMBER_NAME=Regular User
SEED_MEMBER_EMAIL=user@example.com
SEED_MEMBER_PASSWORD=user-password

# --- Job agent -------------------------------------------------------------
# Public Telegram channels are read from their web preview, so no session or
# bot token is needed. Add channels on the Profile page.
# Minutes between automatic scans of those channels. 0 disables the loop.
AGENT_INGEST_MINUTES=0
# Ordered LLM chain. Each provider with a key is tried in turn until one
# answers. Supported: groq, openrouter, gemini, openai.
AI_PROVIDERS=groq,openrouter,gemini
AI_MODEL=openai/gpt-oss-120b
# Provider keys. Leave a key empty to skip that provider.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# --- Closing-date reminders ------------------------------------------------
# Free Telegram bot messages before a posting closes. Create a bot by messaging
# @BotFather, send it any message, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates. Leave the token empty to turn
# reminders off; SMS is not offered because no free gateway covers Ethiopia.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- Command bot -----------------------------------------------------------
# A second bot, from @BotFather, that answers /closing, /jobs, /job, /applied
# and /scan. It stays separate so the reminder bot above remains one-way.
# Leave empty to disable it. It uses TELEGRAM_CHAT_ID and refuses other chats.
TELEGRAM_AGENT_BOT_TOKEN=
# Chats allowed to command the bot, comma separated (the owner's chat above is
# always allowed). A refused chat is told its own id, so a friend can send you
# theirs. Everyone allowed sees the same postings.
TELEGRAM_ALLOWED_CHAT_IDS=
# Warn this many days before the closing date. 0 means only on the last day.
DEADLINE_REMINDER_DAYS=3
# Minutes between checks. 0 disables the background loop.
DEADLINE_CHECK_MINUTES=30

# Legacy single endpoint. When LLM_API_KEY is set it runs ahead of AI_PROVIDERS.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
